# Secret template for API keys and encryption key
# IMPORTANT: This is a template. Never commit actual secrets to git!
#
# To create this secret:
# 1. Generate API keys:
#    openssl rand -base64 32
#
# 2. Generate encryption key (32 bytes hex-encoded for AES-256):
#    openssl rand -hex 32
#
# 3. Create the secret:
#    kubectl create secret generic codex-secrets \
#      --from-literal=CODEX_API_KEYS='<key1>,<key2>' \
#      --from-literal=CODEX_ENCRYPTION_KEY='<hex-encoded-key>'
#
# Or use sealed-secrets, external-secrets, or your secret management tool

apiVersion: v1
kind: Secret
metadata:
  name: codex-secrets
  labels:
    app: codex
    component: secrets
type: Opaque
stringData:
  # API keys (comma-separated, base64-encoded in actual secret)
  # Example: key1,key2,key3
  CODEX_API_KEYS: "change-me-to-your-api-key-1,change-me-to-your-api-key-2"

  # AES encryption key (32 bytes hex-encoded for AES-256)
  # Leave empty to disable encryption
  # Example: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  CODEX_ENCRYPTION_KEY: ""

---
# Alternative: Using kubernetes native secret format (base64)
# apiVersion: v1
# kind: Secret
# metadata:
#   name: codex-secrets
#   labels:
#     app: codex
#     component: secrets
# type: Opaque
# data:
#   CODEX_API_KEYS: Y2hhbmdlLW1lLXRvLXlvdXItYXBpLWtleQ==  # base64(change-me-to-your-api-key)
#   CODEX_ENCRYPTION_KEY: ""  # empty string for no encryption
